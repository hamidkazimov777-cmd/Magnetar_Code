{
  "name": "magnetar-code",
  "version": "0.4.0",
  "description": "Magnetar Code \u2014 a terminal AI coding agent with a local web monitor. Bring your own key: any OpenAI-compatible endpoint.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "tui",
    "coding-assistant",
    "llm",
    "byok",
    "openai-compatible"
  ],
  "homepage": "https://github.com/hamidkazimov777-cmd/Magnetar_Code#readme",
  "bugs": "https://github.com/hamidkazimov777-cmd/Magnetar_Code/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamidkazimov777-cmd/Magnetar_Code.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Hamid Kazimov",
  "type": "module",
  "bin": {
    "magnetar": "dist/cli.js",
    "magnetar-code": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/bundle-monitor.mjs",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build -w @magnetar/web && npm run build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "ink": "^7.1.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@magnetar/core": "*",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13"
  }
}
